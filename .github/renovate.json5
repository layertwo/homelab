{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>layertwo/renovate-config',
    'github>layertwo/homelab//.github/renovate/allowed-versions.json5',
    'github>layertwo/homelab//.github/renovate/custom-managers.json5',
    'github>layertwo/homelab//.github/renovate/package-rules.json5',
  ],
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)clusters/.+\\.ya?ml$/',
    ],
  },
  flux: {
    managerFilePatterns: [
      '/(^|/)clusters/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)clusters/.+\\.ya?ml$/',
    ],
  },
  terraform: {
    managerFilePatterns: [
      '/(^|/)cloud/.+\\.json$/',
    ],
  },
}
