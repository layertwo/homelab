{
    "name": "r2",
    "private": true,
    "version": "1.0.0",
    "license": "MPL-2.0",
    "main": "lib/app.js",
    "types": "lib/app.ts",
    "engines": {
        "node": ">=18.0"
    },
    "scripts": {
        "build": "tsc",
        "cdk:apply": "TERRAFORM_BINARY_NAME=tofu cdktf apply",
        "cdk:destroy": "TERRAFORM_BINARY_NAME=tofu cdktf destroy",
        "cdk:diff": "TERRAFORM_BINARY_NAME=tofu cdktf diff",
        "cdk:get": "TERRAFORM_BINARY_NAME=tofu cdktf get",
        "cdk:list": "TERRAFORM_BINARY_NAME=tofu cdktf list",
        "cdk:plan": "TERRAFORM_BINARY_NAME=tofu cdktf plan",
        "cdk:synth": "TERRAFORM_BINARY_NAME=tofu cdktf synth",
        "check-format": "eslint lib package.json eslint.config.mjs .prettierrc.js",
        "clean": "find \"/lib/**/*{.js,.d.ts}\" -type f -delete",
        "compile": "tsc --pretty",
        "format": "npm run check-format -- --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "watch": "tsc -w"
    },
    "dependencies": {
        "@cdktf/provider-aws": "^21.22.1",
        "@cdktf/provider-cloudflare": "^13.9.1",
        "cdktf": "^0.21.0",
        "constructs": "^10.4.2"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin-js": "^4.0.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "*",
        "@typescript-eslint/eslint-plugin": "^8.18.0",
        "@typescript-eslint/parser": "^8.18.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-prettier": "^5.1.3",
        "jest": "^30.0.0",
        "prettier": "^3.2.5",
        "prettier-plugin-pkgsort": "^0.3.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.0",
        "brace-expansion": "^2.0.2",
        "glob": "^10.5.0",
        "lodash-es": "^4.17.23",
        "lodash": "^4.17.23"
    },
    "overrides": {
        "brace-expansion": "^2.0.2",
        "glob": "^10.5.0",
        "lodash-es": "^4.17.23",
        "lodash": "^4.17.23"
    }
}
